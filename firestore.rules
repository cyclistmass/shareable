rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function seated(g) { return signed() && (g.seats['0'].uid == request.auth.uid || g.seats['1'].uid == request.auth.uid || g.seats['2'].uid == request.auth.uid || g.seats['3'].uid == request.auth.uid); }
    function seat(s) { return s.keys().hasOnly(['uid','name','bot','open','ready','google']) && (s.uid == null || s.uid is string) && s.name is string && s.name.size() <= 80 && (s.bot == null || s.bot in ['EASY','GREEDY','STRONG']) && s.open is bool && s.ready is bool && s.get('google', false) is bool; }
    // A room or move deletes itself at expireAt (#72; a Firestore TTL policy on that field). The app sets at most 30 days
    // ahead by the phone's clock; 60 here leaves room for a clock that is off, so its moves are never refused.
    function expiry(d) { return d.get('expireAt', request.time) is timestamp && d.get('expireAt', request.time) <= request.time + duration.value(60, 'd'); }
    function code(c) { return c is string && c.size() <= 12; }
    // #72: who the host invited (seen on their start screen), the room this one plays again, and its own rematch.
    function links(g) { return g.get('invited', []) is list && g.get('invited', []).size() <= 3 && code(g.get('rematchOf', '')) && code(g.get('next', '')); }
    function valid(g) { return g.keys().hasOnly(['host','status','seed','nextSeq','decks','seats','options','version','createdAt','lastMove','invited','rematchOf','next','expireAt']) && g.host is string && g.status in ['lobby','playing','done'] && g.seed is string && g.version in [1, 2, 3] && expiry(g) && links(g) && g.nextSeq is int && g.nextSeq >= 0 && g.decks is int && g.decks >= 0 && g.decks <= 4 && g.options is map && g.createdAt is timestamp && g.seats.keys().hasAll(['0','1','2','3']) && g.seats.size() == 4 && seat(g.seats['0']) && seat(g.seats['1']) && seat(g.seats['2']) && seat(g.seats['3']) && g.seats['0'].uid == g.host; }
    function selfSeat(k) {
      let a = resource.data.seats[k]; let b = request.resource.data.seats[k];
      return resource.data.seats.diff(request.resource.data.seats).affectedKeys().hasOnly([k]) &&
        ((a.uid == request.auth.uid && b.diff(a).affectedKeys().hasOnly(['ready'])) ||
         (k != '0' && a.uid == null && a.open && !seated(resource.data) && b.uid == request.auth.uid && b.bot == a.bot && b.open == false && b.ready == false) ||
         (k != '0' && a.uid == request.auth.uid && b.uid == null && b.name == '' && b.bot == a.bot && b.open && !b.ready));
    }
    function selfChange() {
      let changed = resource.data.seats.diff(request.resource.data.seats).affectedKeys();
      let k = changed.hasAny(['1']) ? '1' : (changed.hasAny(['2']) ? '2' : '3');
      return changed.size() == 1 && !changed.hasAny(['0']) && selfSeat(k);
    }
    // A guest quits a running game (Mauro, 2026-10-11): their own seat, not the host's, goes to a bot that the
    // host's phone then plays; nothing else changes.
    function quitSeat(k) {
      let a = resource.data.seats[k]; let b = request.resource.data.seats[k];
      return k != '0' && a.uid == request.auth.uid && b.uid == null && b.name == '' && b.bot in ['EASY','GREEDY','STRONG'] && b.open == false && b.ready == false;
    }
    function quitChange() {
      let changed = resource.data.seats.diff(request.resource.data.seats).affectedKeys();
      let k = changed.hasAny(['1']) ? '1' : (changed.hasAny(['2']) ? '2' : '3');
      return changed.size() == 1 && !changed.hasAny(['0']) && quitSeat(k);
    }
    // Crash reports from players: anyone signed in may add one; nobody can read, change or delete them
    // (Mauro reads them in the Firebase console).
    match /crashes/{id} {
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid','report','createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.report is string &&
        request.resource.data.report.size() <= 200000 && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // A report's screenshots (#128): a base64 JPEG each, pointing at its report; write-only, like the reports.
    match /shots/{id} {
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid','crash','n','image','createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.crash is string &&
        request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 2 &&
        request.resource.data.image is string && request.resource.data.image.size() <= 450000 &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // The people you played online with (#72): yours alone, never anyone else's to read.
    match /users/{uid}/met/{other} {
      allow read, delete: if signed() && request.auth.uid == uid;
      allow create, update: if signed() && request.auth.uid == uid && other != uid &&
        request.resource.data.keys().hasOnly(['name','lastPlayed','games','starred']) && request.resource.data.name is string &&
        request.resource.data.name.size() <= 80 && request.resource.data.lastPlayed is timestamp && request.resource.data.games is int &&
        request.resource.data.games >= 0 && request.resource.data.starred is bool;
    }
    match /games/{game} {
      // A missing room is readable (it only says the code is free): creating a room checks that in a transaction.
      // An invited player may see the room in any state: their start screen asks for the rooms that invite them (#72).
      allow read: if signed() && (resource == null || resource.data.status == 'lobby' || seated(resource.data) ||
        request.auth.uid in resource.data.get('invited', []));
      allow create: if signed() && valid(request.resource.data) && request.resource.data.host == request.auth.uid && request.resource.data.status == 'lobby' && request.resource.data.nextSeq == 0 && request.resource.data.createdAt == request.time && request.resource.data.seats['1'].uid == null && request.resource.data.seats['2'].uid == null && request.resource.data.seats['3'].uid == null;
      allow update: if signed() && valid(request.resource.data) && (
        (resource.data.status == 'lobby' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats','status','options','invited','expireAt']) &&
          ((resource.data.host == request.auth.uid && request.resource.data.status in ['lobby','playing']) ||
           (request.resource.data.status == 'lobby' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats']) && selfChange()))) ||
        (resource.data.status == 'playing' && resource.data.host == request.auth.uid && request.resource.data.status == 'done' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','expireAt'])) ||
        // The host points a finished room at its rematch, once (#72).
        (resource.data.status == 'done' && resource.data.host == request.auth.uid && resource.data.get('next', '') == '' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])) ||
        (resource.data.status == 'playing' && request.resource.data.status == 'playing' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats']) && quitChange())
      );
      match /moves/{move} {
        function parent() { return get(/databases/$(database)/documents/games/$(game)).data; }
        function predecessor() {
          let m = request.resource.data;
          return (m.seq == 0 && m.prev == '') ||
            (m.seq > 0 && m.prev is string && m.prev.size() == 10 && m.prev.matches('0*' + string(m.seq - 1)) &&
             get(/databases/$(database)/documents/games/$(game)/moves/$(m.prev)).data.seq == m.seq - 1);
        }
        allow read: if signed() && (parent().status == 'lobby' || seated(parent()));
        allow create: if signed() && parent().status == 'playing' && seated(parent()) &&
          request.resource.data.keys().hasOnly(['seq','seat','uid','action','prev','expireAt']) && expiry(request.resource.data) && request.resource.data.seq >= 0 && request.resource.data.seq <= 9999999999 &&
          request.resource.data.seq is int && request.resource.data.seat in ['0','1','2','3'] && request.resource.data.uid == request.auth.uid &&
          (parent().seats[request.resource.data.seat].uid == request.auth.uid || (parent().host == request.auth.uid && parent().seats[request.resource.data.seat].uid == null && parent().seats[request.resource.data.seat].bot != null)) &&
          request.resource.data.action is string && request.resource.data.action.size() <= 100 && request.resource.data.action.matches('1:[A-Z_]+:[0-9]+') &&
          move.size() == 10 && move.matches('0*' + string(request.resource.data.seq)) && predecessor();
      }
    }
  }
}



