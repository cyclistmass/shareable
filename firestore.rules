rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function seated(g) { return signed() && (g.seats['0'].uid == request.auth.uid || g.seats['1'].uid == request.auth.uid || g.seats['2'].uid == request.auth.uid || g.seats['3'].uid == request.auth.uid); }
    function seat(s) { return s.keys().hasOnly(['uid','name','bot','open','ready','google']) && (s.uid == null || (s.uid is string && s.uid.size() <= 128)) && s.name is string && s.name.size() <= 80 && (s.bot == null || s.bot in ['EASY','GREEDY','STRONG']) && s.open is bool && s.ready is bool && s.get('google', false) is bool; }
    // A room and its moves expire at expireAt (#72); the host's app then deletes them (see delete below). The app sets at most 30 days
    // ahead by the phone's clock; 60 here leaves room for a clock that is off, so its moves are never refused.
    function expiry(d) { return d.get('expireAt', request.time) is timestamp && d.get('expireAt', request.time) <= request.time + duration.value(60, 'd'); }
    function code(c) { return c is string && c.size() <= 12; }
    function expired(d) { return d.get('expireAt', null) is timestamp && d.expireAt < request.time; }
    // #72: who the host invited (seen on their start screen), the room this one plays again, and its own rematch.
    function links(g) { return g.get('invited', []) is list && g.get('invited', []).size() <= 3 && code(g.get('rematchOf', '')) && code(g.get('next', '')); }
    // (Checked only when written: every rule here shares a budget of 1000 expressions per request.)
    // The game settings every app version writes (randomFirstPlayer from 0.2.10, colours from 0.3.4), each typed and
    // bounded: a malformed room would fail to load on the other phones, and an oversized one would be downloaded by all.
    // Colours are SeatColour names; a new colour needs its name here, deployed before the app that uses it.
    function opts(o) { return o.keys().hasOnly(['expansion','numPlayers','vpToWin','layout','avoidAdjacentRedNumbers','discardLimit','maxTurns','randomDiscard','generateTradeOffers','randomFirstPlayer','colours']) &&
      o.expansion is string && o.expansion.size() <= 30 && o.numPlayers is int && o.vpToWin is int && o.layout is string && o.layout.size() <= 30 &&
      o.avoidAdjacentRedNumbers is bool && o.discardLimit is int && o.maxTurns is int && o.randomDiscard is bool && o.generateTradeOffers is bool &&
      o.get('randomFirstPlayer', false) is bool && o.get('colours', []) is list && o.get('colours', []).size() <= 6 &&
      o.get('colours', []).hasOnly(['RED','BLUE','ORANGE','WHITE','YELLOW','PURPLE','BLACK']); }
    // A room's fields apart from its seats; valid() adds the seats.
    function top(g) { return g.keys().hasOnly(['host','status','seed','nextSeq','decks','seats','options','version','createdAt','lastMove','invited','rematchOf','next','expireAt']) && g.host is string && g.host.size() <= 128 && g.status in ['lobby','playing','done'] && g.seed is string && g.seed.size() <= 24 && g.get('lastMove', '') is string && g.get('lastMove', '').size() <= 20 && g.version in [1, 2, 3] && expiry(g) && links(g) && g.nextSeq is int && g.nextSeq >= 0 && g.decks is int && g.decks >= 0 && g.decks <= 4 && g.options is map && g.createdAt is timestamp && g.seats.keys().hasAll(['0','1','2','3']) && g.seats.size() == 4 && g.seats['0'].uid == g.host; }
    function valid(g) { return top(g) && seat(g.seats['0']) && seat(g.seats['1']) && seat(g.seats['2']) && seat(g.seats['3']); }
    // A seat says its player signed in with Google only for the player themselves, and only when they really did; others'
    // phones put that player on their list of people played with (#72). A mark already there may stay as it is.
    function googleUser() { let f = request.auth.token.get('firebase', {}); return f.get('sign_in_provider', '') == 'google.com' || f.get('identities', {}).keys().hasAny(['google.com']); }
    // On an update only the seats that changed (sc) are checked, the cheap tests first.
    function markKept(a, b) { return !b.get('google', false) || (a.get('google', false) == true && a.uid == b.uid) || (b.uid == request.auth.uid && googleUser()); }
    function marksKept(r, d, sc) { return (!sc.hasAny(['0']) || markKept(r.seats['0'], d.seats['0'])) && (!sc.hasAny(['1']) || markKept(r.seats['1'], d.seats['1'])) &&
      (!sc.hasAny(['2']) || markKept(r.seats['2'], d.seats['2'])) && (!sc.hasAny(['3']) || markKept(r.seats['3'], d.seats['3'])); }
    // The host invites only people who played with them, so strangers can't be sent invites: each invitee has the host on
    // their own list (#72), or sat in the host's room that this one plays again (a rematch invites everyone back, Google or not).
    function players(g) { let r = get(/databases/$(database)/documents/games/$(g.rematchOf)).data;
      return r.host == request.auth.uid ? [r.seats['1'].uid, r.seats['2'].uid, r.seats['3'].uid] : []; }
    function knows(g, u) { return exists(/databases/$(database)/documents/users/$(u)/met/$(request.auth.uid)) || (g.get('rematchOf', '') != '' && u in players(g)); }
    function invitesOk(g) { let l = g.get('invited', []); return l.size() == 0 || (g.get('rematchOf', '') != '' && players(g).hasAll(l)) ||
      ((l.size() < 1 || knows(g, l[0])) && (l.size() < 2 || knows(g, l[1])) && (l.size() < 3 || knows(g, l[2]))); }
    // A new room seats only its host, so only seat 0 can carry a mark (an empty seat's mark names nobody).
    function createOk(d) { return valid(d) && d.host == request.auth.uid && d.status == 'lobby' && d.nextSeq == 0 && d.createdAt == request.time &&
      d.seats['1'].uid == null && d.seats['2'].uid == null && d.seats['3'].uid == null && opts(d.options) &&
      (!d.seats['0'].get('google', false) || googleUser()) && invitesOk(d); }
    // A guest changes only their own seat (never the host's): ready or not, take an open seat while holding none, or leave it.
    function seatKey(sc) { return sc.hasAny(['1']) ? '1' : (sc.hasAny(['2']) ? '2' : '3'); }
    function selfChange(r, d, sc) {
      let k = seatKey(sc); let a = r.seats[k]; let b = d.seats[k];
      return sc.size() == 1 && !sc.hasAny(['0']) &&
        ((a.uid == request.auth.uid && b.diff(a).affectedKeys().hasOnly(['ready'])) ||
         (a.uid == null && a.open && !seated(r) && b.uid == request.auth.uid && b.bot == a.bot && b.open == false && b.ready == false) ||
         (a.uid == request.auth.uid && b.uid == null && b.name == '' && b.bot == a.bot && b.open && !b.ready));
    }
    // A guest quits a running game (Mauro, 2026-10-11): their own seat, not the host's, goes to a bot that the
    // host's phone then plays; nothing else changes.
    function quitChange(r, d, sc) {
      let k = seatKey(sc); let a = r.seats[k]; let b = d.seats[k];
      return sc.size() == 1 && !sc.hasAny(['0']) && a.uid == request.auth.uid && b.uid == null && b.name == '' && b.bot in ['EASY','GREEDY','STRONG'] && b.open == false && b.ready == false;
    }
    // Every rule shares a budget of 1000 expressions per request, so the diffs are taken once and each check (a seat,
    // the settings, the marks, the invites) runs only when its field is written; the seats left alone were checked when written. A new expiry is always in the future, so nobody can make a running game deletable at once.
    function updateOk(r, d) {
      let ch = d.diff(r).affectedKeys(); let sc = r.seats.diff(d.seats).affectedKeys(); let me = request.auth.uid;
      return top(d) && (!sc.hasAny(['0']) || seat(d.seats['0'])) && (!sc.hasAny(['1']) || seat(d.seats['1'])) &&
        (!sc.hasAny(['2']) || seat(d.seats['2'])) && (!sc.hasAny(['3']) || seat(d.seats['3'])) && (!ch.hasAny(['expireAt']) || d.expireAt > request.time) && (!ch.hasAny(['options']) || opts(d.options)) &&
        (!ch.hasAny(['seats']) || marksKept(r, d, sc)) && (!ch.hasAny(['invited']) || invitesOk(d)) && (
        (r.status == 'lobby' && ch.hasOnly(['seats','status','options','invited','expireAt']) &&
          ((r.host == me && d.status in ['lobby','playing']) || (d.status == 'lobby' && ch.hasOnly(['seats']) && selfChange(r, d, sc)))) ||
        (r.status == 'playing' && r.host == me && d.status == 'done' && ch.hasOnly(['status','expireAt'])) ||
        // The host points a finished room at its rematch, once (#72).
        (r.status == 'done' && r.host == me && r.get('next', '') == '' && ch.hasOnly(['next'])) ||
        (r.status == 'playing' && d.status == 'playing' && ch.hasOnly(['seats']) && quitChange(r, d, sc)));
    }
    // Crash reports from players: anyone signed in may add one; nobody can read, change or delete them
    // (Mauro reads them in the Firebase console).
    match /crashes/{id} {
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid','report','createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.report is string &&
        request.resource.data.report.size() <= 200000 && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // A report's screenshots (#128): a base64 JPEG each, pointing at its report; write-only, like the reports.
    match /shots/{id} {
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid','crash','n','image','createdAt']) &&
        request.resource.data.uid == request.auth.uid && request.resource.data.crash is string && request.resource.data.crash.size() <= 40 &&
        request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 2 &&
        request.resource.data.image is string && request.resource.data.image.size() <= 450000 &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // The people you played online with (#72): yours alone, never anyone else's to read.
    match /users/{uid}/met/{other} {
      allow read, delete: if signed() && request.auth.uid == uid;
      allow create, update: if signed() && request.auth.uid == uid && other != uid &&
        request.resource.data.keys().hasOnly(['name','lastPlayed','games','starred']) && request.resource.data.name is string &&
        request.resource.data.name.size() <= 80 && request.resource.data.lastPlayed is timestamp && request.resource.data.games is int &&
        request.resource.data.games >= 0 && request.resource.data.starred is bool;
    }
    match /games/{game} {
      // A missing room is readable (it only says the code is free): creating a room checks that in a transaction.
      // An invited player may see the room in any state: their start screen asks for the rooms that invite them (#72).
      // The host finds their own rooms by query to clear the expired ones. Open lobbies are read by code only, never
      // listed: a list would hand out every waiting player's id and name.
      allow get: if signed() && (resource == null || resource.data.status == 'lobby' || seated(resource.data) ||
        request.auth.uid in resource.data.get('invited', []) || resource.data.host == request.auth.uid);
      allow list: if signed() && (seated(resource.data) || request.auth.uid in resource.data.get('invited', []) || resource.data.host == request.auth.uid);
      // No TTL without billing: the host's app deletes its own rooms once expireAt is past (moves first, below).
      allow delete: if signed() && resource.data.host == request.auth.uid && expired(resource.data);
      allow create: if signed() && createOk(request.resource.data);
      allow update: if signed() && updateOk(resource.data, request.resource.data);
      match /moves/{move} {
        function parent() { return get(/databases/$(database)/documents/games/$(game)).data; }
        function predecessor() {
          let m = request.resource.data;
          return (m.seq == 0 && m.prev == '') ||
            (m.seq > 0 && m.prev is string && m.prev.size() == 10 && m.prev.matches('0*' + string(m.seq - 1)) &&
             get(/databases/$(database)/documents/games/$(game)/moves/$(m.prev)).data.seq == m.seq - 1);
        }
        allow read: if signed() && (parent().status == 'lobby' || seated(parent()));
        allow delete: if signed() && parent().host == request.auth.uid && expired(parent());
        allow create: if signed() && parent().status == 'playing' && seated(parent()) &&
          request.resource.data.keys().hasOnly(['seq','seat','uid','action','prev','expireAt']) && expiry(request.resource.data) && request.resource.data.seq >= 0 && request.resource.data.seq <= 9999999999 &&
          request.resource.data.seq is int && request.resource.data.seat in ['0','1','2','3'] && request.resource.data.uid == request.auth.uid &&
          (parent().seats[request.resource.data.seat].uid == request.auth.uid || (parent().host == request.auth.uid && parent().seats[request.resource.data.seat].uid == null && parent().seats[request.resource.data.seat].bot != null)) &&
          request.resource.data.action is string && request.resource.data.action.size() <= 100 && request.resource.data.action.matches('1:[A-Z_]+:[0-9]+') &&
          move.size() == 10 && move.matches('0*' + string(request.resource.data.seq)) && predecessor();
      }
    }
  }
}



